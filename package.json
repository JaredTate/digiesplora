{
  "name": "esplora",
  "version": "0.1.0",
  "scripts": {
    "dev-server": "babel-node dev-server.js",
    "prerender-server": "cd prerender-server && npm start",
    "postinstall": "(cd client && npm install) && (cd prerender-server && npm install)",
    "dist": "./build.sh",
    "test": "node test/seo.js && babel-node test/digidollar-ui.js && babel-node test/client-ui.js && babel-node test/address-ui.js && babel-node test/ux-fixes.js",
    "test:smoke": "node test/smoke.js",
    "test:seo": "node test/seo.js",
    "l10n:fetch": "./lang/util/fetch-transifex.sh",
    "l10n:update-strings": "./lang/util/update-strings.sh"
  },
  "author": "Nadav Ivgi",
  "license": "MIT",
  "browserslist": "> 0.5%, ie 11",
  "devDependencies": {
    "browserify-middleware": "^8.1.1",
    "express": "^4.22.1",
    "glob": "^7.1.6",
    "morgan": "^1.10.0"
  },
  "dependencies": {
    "@babel/cli": "^7.29.0",
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "browserify": "^17.0.0",
    "bundle-collapser": "^1.4.0",
    "cssjanus": "^2.0.1",
    "move-decimal-point": "0.0.4",
    "patch-package": "^8.0.1",
    "pofile": "^1.1.0",
    "pug": "^3.0.0",
    "pug-cli": "^1.0.0-alpha6",
    "snabbdom-to-html": "^6.0.0",
    "typeface-inconsolata": "0.0.72",
    "uglify-es": "^3.3.9"
  },
  "overrides": {
    "watchify": "^4.0.0",
    "browserify-middleware": {
      "browserify": "$browserify"
    },
    "pug-cli": {
      "pug": "$pug"
    }
  }
}
